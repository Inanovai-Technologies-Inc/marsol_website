{% extends "templates/web.html" %}
{% block style %}
<link rel="stylesheet" href="/assets/marsol_website/css/marsol-home.css">
{% endblock %}

{% block page_content %}

<div class="marsol-home">

    <!-- =====================================================
         HERO
    ====================================================== -->

    <section class="marsol-hero">

        <div class="marsol-hero-bg"></div>

        <div class="marsol-hero-overlay"></div>

        <div class="marsol-hero-content">

            <span class="marsol-eyebrow">
                FIRE SUPPRESSION ENGINEERING
            </span>

            <h1>
                Built for the
                <span>moment it matters.</span>
            </h1>

            <p>
                Engineered fire suppression solutions for
                industrial, marine, aviation and high-risk
                environments.
            </p>

            <div class="marsol-hero-actions">

                <a href="/products"
                   class="marsol-btn marsol-btn-primary">
                    Explore Our Solutions
                    <span>→</span>
                </a>

                <a href="/about"
                   class="marsol-btn marsol-btn-outline">
                    About Marsol
                </a>

            </div>

        </div>

        <div class="marsol-hero-scroll">
            <span></span>
            Scroll to explore
        </div>

    </section>


    <!-- =====================================================
         TRUST STRIP
    ====================================================== -->

    <section class="marsol-trust">

        <div class="marsol-trust-item">
            <strong>Industrial</strong>
            <span>Protection</span>
        </div>

        <div class="marsol-trust-item">
            <strong>Marine</strong>
            <span>Safety Systems</span>
        </div>

        <div class="marsol-trust-item">
            <strong>Aviation</strong>
            <span>Fire Protection</span>
        </div>

        <div class="marsol-trust-item">
            <strong>Energy</strong>
            <span>Risk Protection</span>
        </div>

    </section>


    <!-- =====================================================
         INTRO
    ====================================================== -->

    <section class="marsol-intro marsol-reveal">

        <div class="marsol-section-label">
            WHAT WE DO
        </div>

        <h2>
            Protection engineered
            <span>for real-world risk.</span>
        </h2>

        <p>
            Marsol Technologies delivers advanced fire
            suppression equipment and engineered protection
            systems designed for demanding environments.
        </p>

    </section>


    <!-- =====================================================
         PRODUCTS
    ====================================================== -->

    <section class="marsol-products">

        <div class="marsol-section-heading marsol-reveal">

            <div>
                <div class="marsol-section-label">
                    OUR SOLUTIONS
                </div>

                <h2>
                    Engineered to protect.
                </h2>
            </div>

            <a href="/products"
               class="marsol-text-link">
                View all products →
            </a>

        </div>


        <div class="marsol-product-grid">


            <!-- PRODUCT 1 -->

            <a href="/products"
               class="marsol-product-card marsol-reveal">

                <div class="marsol-product-image">

                    <img
                        src="/assets/marsol_website/images/foam-fire-fighting-station.png"
                        alt="Fire suppression system">

                    <div class="marsol-product-number">
                        01
                    </div>

                </div>

                <div class="marsol-product-content">

                    <span>
                        FIRE SUPPRESSION
                    </span>

                    <h3>
                        Fire Suppression Systems
                    </h3>

                    <p>
                        Advanced systems engineered for
                        industrial, marine and high-risk
                        environments.
                    </p>

                    <strong>
                        Explore solution →
                    </strong>

                </div>

            </a>


            <!-- PRODUCT 2 -->

            <a href="/products"
               class="marsol-product-card marsol-reveal">

                <div class="marsol-product-image">

                    <img
                        src="/assets/marsol_website/images/foam-tank-skid-diffs.png"
                        alt="Foam tank skid">

                    <div class="marsol-product-number">
                        02
                    </div>

                </div>

                <div class="marsol-product-content">

                    <span>
                        FOAM SYSTEMS
                    </span>

                    <h3>
                        Foam Handling Equipment
                    </h3>

                    <p>
                        Specialized foam handling and
                        suppression equipment for demanding
                        applications.
                    </p>

                    <strong>
                        Explore solution →
                    </strong>

                </div>

            </a>


            <!-- PRODUCT 3 -->

            <a href="/products"
               class="marsol-product-card marsol-reveal">

                <div class="marsol-product-image">

                    <img
                        src="/assets/marsol_website/images/bladder-tank.png"
                        alt="Bladder tank">

                    <div class="marsol-product-number">
                        03
                    </div>

                </div>

                <div class="marsol-product-content">

                    <span>
                        STORAGE & DELIVERY
                    </span>

                    <h3>
                        Bladder Tank Systems
                    </h3>

                    <p>
                        Reliable foam concentrate storage
                        and proportioning solutions.
                    </p>

                    <strong>
                        Explore solution →
                    </strong>

                </div>

            </a>


            <!-- PRODUCT 4 -->

            <a href="/products"
               class="marsol-product-card marsol-reveal">

                <div class="marsol-product-image">

                    <img
                        src="/assets/marsol_website/images/diffs-nozzle.jpg"
                        alt="Diffs nozzle">

                    <div class="marsol-product-number">
                        04
                    </div>

                </div>

                <div class="marsol-product-content">

                    <span>
                        NOZZLES
                    </span>

                    <h3>
                        Diffs Nozzles
                    </h3>

                    <p>
                        Precision engineered discharge
                        equipment for effective fire control.
                    </p>

                    <strong>
                        Explore solution →
                    </strong>

                </div>

            </a>


            <!-- PRODUCT 5 -->

            <a href="/products"
               class="marsol-product-card marsol-reveal">

                <div class="marsol-product-image">

                    <img
                        src="/assets/marsol_website/images/non-pop-in-nozzle.png"
                        alt="Non pop in nozzle">

                    <div class="marsol-product-number">
                        05
                    </div>

                </div>

                <div class="marsol-product-content">

                    <span>
                        FIRE EQUIPMENT
                    </span>

                    <h3>
                        Non Pop-In Nozzles
                    </h3>

                    <p>
                        Robust fire suppression components
                        designed for reliable operation.
                    </p>

                    <strong>
                        Explore solution →
                    </strong>

                </div>

            </a>


            <!-- PRODUCT 6 -->

            <a href="/products"
               class="marsol-product-card marsol-reveal">

                <div class="marsol-product-image">

                    <img
                        src="/assets/marsol_website/images/marsol-inductor.png"
                        alt="Marsol inductor">

                    <div class="marsol-product-number">
                        06
                    </div>

                </div>

                <div class="marsol-product-content">

                    <span>
                        PROPORTIONING
                    </span>

                    <h3>
                        Marsol Inductor
                    </h3>

                    <p>
                        Engineered proportioning equipment
                        for dependable foam delivery.
                    </p>

                    <strong>
                        Explore solution →
                    </strong>

                </div>

            </a>

        </div>

    </section>


    <!-- =====================================================
         INDUSTRIES
    ====================================================== -->

    <section class="marsol-industries">

        <div class="marsol-section-heading marsol-reveal">

            <div>

                <div class="marsol-section-label">
                    INDUSTRIES
                </div>

                <h2>
                    Protection across
                    <span>critical industries.</span>
                </h2>

            </div>

        </div>


        <div class="marsol-industry-grid">


            <a href="/contact"
               class="marsol-industry-card">

                <div class="marsol-industry-bg marine-bg"></div>

                <div class="marsol-industry-content">

                    <span>01</span>

                    <h3>
                        Marine
                    </h3>

                    <p>
                        Fire protection for vessels,
                        offshore platforms and marine
                        environments.
                    </p>

                    <strong>
                        Discover →
                    </strong>

                </div>

            </a>


            <a href="/contact"
               class="marsol-industry-card">

                <div class="marsol-industry-bg industrial-bg"></div>

                <div class="marsol-industry-content">

                    <span>02</span>

                    <h3>
                        Industrial
                    </h3>

                    <p>
                        Engineered protection for
                        demanding industrial facilities.
                    </p>

                    <strong>
                        Discover →
                    </strong>

                </div>

            </a>


            <a href="/contact"
               class="marsol-industry-card">

                <div class="marsol-industry-bg aviation-bg"></div>

                <div class="marsol-industry-content">

                    <span>03</span>

                    <h3>
                        Aviation
                    </h3>

                    <p>
                        Specialized fire protection
                        for aviation applications.
                    </p>

                    <strong>
                        Discover →
                    </strong>

                </div>

            </a>


            <a href="/contact"
               class="marsol-industry-card">

                <div class="marsol-industry-bg energy-bg"></div>

                <div class="marsol-industry-content">

                    <span>04</span>

                    <h3>
                        Energy & EV
                    </h3>

                    <p>
                        Advanced protection for battery
                        and energy storage environments.
                    </p>

                    <strong>
                        Discover →
                    </strong>

                </div>

            </a>

        </div>

    </section>


    <!-- =====================================================
         WHY MARSOL
    ====================================================== -->

    <section class="marsol-why">

        <div class="marsol-why-image marsol-reveal">

            <img
                src="/assets/marsol_website/images/self-contained-diffs.png"
                alt="Marsol fire suppression equipment">

        </div>


        <div class="marsol-why-content marsol-reveal">

            <div class="marsol-section-label">
                WHY MARSOL
            </div>

            <h2>
                Engineering that
                puts protection first.
            </h2>

            <p>
                Every Marsol solution is designed around
                reliability, performance and the demands
                of the environment where it operates.
            </p>


            <div class="marsol-features">

                <div class="marsol-feature">

                    <span>01</span>

                    <div>
                        <h3>
                            Engineered Solutions
                        </h3>

                        <p>
                            Systems designed around
                            application-specific requirements.
                        </p>
                    </div>

                </div>


                <div class="marsol-feature">

                    <span>02</span>

                    <div>
                        <h3>
                            Reliable Performance
                        </h3>

                        <p>
                            Equipment built for demanding
                            operating environments.
                        </p>
                    </div>

                </div>


                <div class="marsol-feature">

                    <span>03</span>

                    <div>
                        <h3>
                            Safety Focused
                        </h3>

                        <p>
                            Protection where failure is
                            simply not an option.
                        </p>
                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CTA
    ====================================================== -->

    <section class="marsol-cta">

        <div class="marsol-cta-glow"></div>

        <div class="marsol-cta-content">

            <div class="marsol-section-label">
                LET'S TALK
            </div>

            <h2>
                Have a protection
                challenge?
            </h2>

            <p>
                Talk to our team about the right fire
                suppression solution for your application.
            </p>

            <a href="/contact"
               class="marsol-btn marsol-btn-primary">

                Talk to Our Experts

                <span>→</span>

            </a>

        </div>

    </section>


    <!-- =====================================================
         FOOTER INTRO
    ====================================================== -->

    <section class="marsol-footer-intro">

        <div>

            <strong>
                MARSOL
            </strong>

            <span>
                TECHNOLOGIES
            </span>

        </div>

        <p>
            Advanced fire suppression solutions for
            critical environments.
        </p>

    </section>

</div>

{% endblock %}
